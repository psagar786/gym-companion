# Shared public values — add to both Vercel projects
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
MEMBER_APP_URL=https://gym-companion-member.vercel.app
ADMIN_APP_URL=https://gym-companion-coach.vercel.app

# Different in each Vercel project: "member" or "admin"
APP_MODE=member

# Temporary public demo access. Set this to true in both V3 projects only.
DEMO_MODE=false

# Admin Vercel project only. Never add this to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
