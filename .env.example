# Client-safe values, served by /api/config (set in the Vercel V3 project)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Server-only. Never expose this in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_URL=https://your-v3-vercel-url.vercel.app
